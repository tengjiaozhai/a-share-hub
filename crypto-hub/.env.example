BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

CRYPTO_ENABLED=true
CRYPTO_MAX_POSITION_RATIO=0.1
CRYPTO_MAX_DAILY_LOSS=0.05
CRYPTO_MIN_LIQUIDITY=1000000
